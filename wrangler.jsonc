{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pomo-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "vars": {
    "APP_ORIGIN": "https://cordonfocus.com",
    "ALLOWED_ORIGINS": "https://cordonfocus.com,http://localhost:3001"
  },
  "durable_objects": {
    "bindings": [{ "name": "RoomServer", "class_name": "RoomServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomServer"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pomo",
      "database_id": "6fe56f08-fd4d-41c7-bc6b-c3981fc8410b"
    }
  ]
}
